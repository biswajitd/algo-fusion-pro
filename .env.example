# Copy this file to .env and fill in values from your Lovable Cloud / Supabase project.
# The VITE_ prefixed values below are publishable (safe for browsers).
# NEVER put service-role keys or private secrets in this file.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
